<l:BasePropertyControl x:Class="odm.ui.controls.VideoSourceView"
             xmlns:l="clr-namespace:odm.ui.controls"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<l:BasePropertyControl.Resources>
		<BooleanToVisibilityConverter x:Key="BoolToVis"/>
	</l:BasePropertyControl.Resources>

	<l:ContentColumn Title="{Binding Titles.videoSource}" Background="{DynamicResource ResourceKey=PropertyBrush}">
		<Grid>
			<DockPanel Margin="6" Visibility="{Binding StateError}" HorizontalAlignment="Stretch" VerticalAlignment="Top">
				<Button DockPanel.Dock="Bottom" HorizontalAlignment="Left" Margin="0,6,0,0" Command="{Binding ErrorBtnClick}" Content="{Binding ButtonsStrings.continue1}"/>
				<TextBox Text="{Binding ErrorMessage, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" DockPanel.Dock="Top"/>
			</DockPanel>
			<DockPanel Margin="6" Visibility="{Binding StateLoading}" HorizontalAlignment="Left" VerticalAlignment="Top">
				<Label Content="{Binding AppStrings.loading}" DockPanel.Dock="Top"/>
				<ProgressBar IsIndeterminate="True" Width="250" Height="16" DockPanel.Dock="Top"/>
			</DockPanel>
			<StackPanel Visibility="{Binding StateCommon}" Margin="3" HorizontalAlignment="Left" VerticalAlignment="Top" Orientation="Vertical" MinWidth="360">
				<Label Content="{Binding Strings.videoSourceModes}"/>
				<Rectangle Height="2" HorizontalAlignment="Stretch" Fill="{DynamicResource BackgroundHighlight}" Margin="2,2,10,6"/>
				<TextBlock Margin="3" Text="{Binding ModesError}" TextWrapping="Wrap" MaxWidth="420" HorizontalAlignment="Left"/>
				<StackPanel Visibility="{Binding HasModes, Converter={StaticResource BoolToVis}}">
					<ListBox Margin="3" MinHeight="80" MaxHeight="220" ItemsSource="{Binding Modes}" SelectedItem="{Binding SelectedMode}">
						<ListBox.ItemTemplate>
							<DataTemplate>
								<StackPanel Orientation="Horizontal">
									<TextBlock Width="14" Text="&#x2714;" Visibility="{Binding Enabled, Converter={StaticResource BoolToVis}}"/>
									<TextBlock Text="{Binding}"/>
									<TextBlock Margin="8,0,0,0" Foreground="Gray" Text="{Binding Encodings}"/>
								</StackPanel>
							</DataTemplate>
						</ListBox.ItemTemplate>
					</ListBox>
					<Button Margin="3" HorizontalAlignment="Left" Command="{Binding SetModeCommand}" Content="{Binding Strings.setMode}"/>
				</StackPanel>
				<TextBlock Margin="3" Text="{Binding Notice}" Foreground="OrangeRed" TextWrapping="Wrap" MaxWidth="420" HorizontalAlignment="Left"/>

				<Label Margin="0,12,0,0" Content="{Binding Strings.rotation}"/>
				<Rectangle Height="2" HorizontalAlignment="Stretch" Fill="{DynamicResource BackgroundHighlight}" Margin="2,2,10,6"/>
				<TextBlock Margin="3" Text="{Binding RotationError}" TextWrapping="Wrap"/>
				<Grid IsEnabled="{Binding HasRotation}" HorizontalAlignment="Left">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto"/>
						<ColumnDefinition Width="160"/>
					</Grid.ColumnDefinitions>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
					</Grid.RowDefinitions>
					<Label Grid.Row="0" Content="{Binding Strings.rotationMode}"/>
					<ComboBox Grid.Row="0" Grid.Column="1" Margin="2" ItemsSource="{Binding RotateModes}" SelectedItem="{Binding RotateMode}"/>
					<Label Grid.Row="1" Content="{Binding Strings.rotationDegree}"/>
					<ComboBox Grid.Row="1" Grid.Column="1" Margin="2" ItemsSource="{Binding RotateDegrees}" SelectedItem="{Binding RotateDegree}" IsEnabled="{Binding IsDegreeEnabled}"/>
					<Button Grid.Row="2" Grid.Column="1" Margin="2,6,2,2" HorizontalAlignment="Right" Command="{Binding SaveRotationCommand}" Content="{Binding Strings.save}"/>
				</Grid>
				<Button Margin="3,12,3,3" HorizontalAlignment="Left" Command="{Binding RefreshCommand}" Content="{Binding Strings.refresh}"/>
			</StackPanel>
		</Grid>
	</l:ContentColumn>
</l:BasePropertyControl>
