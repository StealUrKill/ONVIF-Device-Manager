<l:BasePropertyControl x:Class="odm.ui.controls.PrivacyMasksView"
             xmlns:l="clr-namespace:odm.ui.controls"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<l:BasePropertyControl.Resources>
		<BooleanToVisibilityConverter x:Key="BoolToVis"/>
	</l:BasePropertyControl.Resources>

	<l:ContentColumn Title="{Binding Titles.privacyMasks}" Background="{DynamicResource ResourceKey=PropertyBrush}">
		<Grid>
			<DockPanel Margin="6" Visibility="{Binding StateError}" HorizontalAlignment="Stretch" VerticalAlignment="Top">
				<Button DockPanel.Dock="Bottom" HorizontalAlignment="Left" Margin="0,6,0,0" Command="{Binding ErrorBtnClick}" Content="{Binding ButtonsStrings.continue1}"/>
				<TextBox Text="{Binding ErrorMessage, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" DockPanel.Dock="Top"/>
			</DockPanel>
			<DockPanel Margin="6" Visibility="{Binding StateLoading}" HorizontalAlignment="Left" VerticalAlignment="Top">
				<Label Content="{Binding AppStrings.loading}" DockPanel.Dock="Top"/>
				<ProgressBar IsIndeterminate="True" Width="250" Height="16" DockPanel.Dock="Top"/>
			</DockPanel>
			<StackPanel Visibility="{Binding StateCommon}" Margin="3" HorizontalAlignment="Left" VerticalAlignment="Top" Orientation="Vertical">
				<TextBlock Margin="3" Text="{Binding Strings.maskDrawHint}"/>
				<!-- The snapshot with the masks. Dragging on it adds a rectangle mask. -->
				<!-- The Viewbox makes the image smaller in a narrow window. The mouse positions stay in canvas units. -->
				<Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left">
				<Border BorderThickness="1" BorderBrush="{DynamicResource BackgroundHighlight}" HorizontalAlignment="Left" Margin="3">
					<Grid x:Name="maskArea" Width="960" Height="540" Background="Black" Cursor="Cross">
						<Image Source="{Binding Snapshot}" Stretch="Fill"/>
						<Canvas x:Name="maskCanvas" Background="Transparent" ClipToBounds="True"/>
					</Grid>
				</Border>
				</Viewbox>
				<TextBlock Margin="3" Text="{Binding Notice}" Foreground="OrangeRed" TextWrapping="Wrap" MaxWidth="960" HorizontalAlignment="Left"/>

				<Grid Margin="0,3,0,0">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto"/>
						<ColumnDefinition Width="Auto"/>
					</Grid.ColumnDefinitions>
					<StackPanel Grid.Column="0" Orientation="Vertical" Margin="3">
						<Label Content="{Binding Strings.masks}"/>
						<ListBox MinHeight="100" MinWidth="180" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}">
							<ListBox.ItemTemplate>
								<DataTemplate>
									<TextBlock Text="{Binding Caption}"/>
								</DataTemplate>
							</ListBox.ItemTemplate>
						</ListBox>
						<StackPanel Orientation="Horizontal" Margin="0,3,0,0">
							<Button Margin="0,0,3,0" Command="{Binding DeleteCommand}" Content="{Binding Strings.delete}"/>
							<Button Command="{Binding RefreshCommand}" Content="{Binding Strings.refresh}"/>
						</StackPanel>
						<TextBlock Margin="0,6,0,0" Text="{Binding Limits}" TextWrapping="Wrap" MaxWidth="200"/>
					</StackPanel>

					<Grid Grid.Column="1" Margin="12,3,3,3" VerticalAlignment="Top" Visibility="{Binding HasSelected, Converter={StaticResource BoolToVis}}">
					<Grid DataContext="{Binding Selected}">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto"/>
							<ColumnDefinition Width="220"/>
						</Grid.ColumnDefinitions>
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="Auto"/>
						</Grid.RowDefinitions>
						<Label Grid.Row="0" Content="{Binding DataContext.Strings.maskType, RelativeSource={RelativeSource AncestorType=l:BasePropertyControl}}"/>
						<ComboBox Grid.Row="0" Grid.Column="1" Margin="2" SelectedItem="{Binding MaskType}"
						          ItemsSource="{Binding DataContext.MaskTypes, RelativeSource={RelativeSource AncestorType=l:BasePropertyControl}}"/>
						<Label Grid.Row="1" Content="{Binding DataContext.Strings.maskEnabled, RelativeSource={RelativeSource AncestorType=l:BasePropertyControl}}"/>
						<CheckBox Grid.Row="1" Grid.Column="1" Margin="2" VerticalAlignment="Center" IsChecked="{Binding Enabled}"/>
						<Label Grid.Row="2" Content="{Binding DataContext.Strings.maskPoints, RelativeSource={RelativeSource AncestorType=l:BasePropertyControl}}"/>
						<TextBox Grid.Row="2" Grid.Column="1" Margin="2" Text="{Binding PointsText}" TextWrapping="Wrap"/>
						<Button Grid.Row="3" Grid.Column="1" Margin="2,6,2,2" HorizontalAlignment="Right"
						        Command="{Binding DataContext.SaveCommand, RelativeSource={RelativeSource AncestorType=l:BasePropertyControl}}"
						        Content="{Binding DataContext.Strings.save, RelativeSource={RelativeSource AncestorType=l:BasePropertyControl}}"/>
					</Grid>
					</Grid>
				</Grid>
			</StackPanel>
		</Grid>
	</l:ContentColumn>
</l:BasePropertyControl>
