<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework">
	<!-- The dark theme. ThemeManager adds this dictionary last, so its brushes replace the light brushes
	     of themes\origin\Brushes.xaml. The keys must be the same as in that file. -->

	<SolidColorBrush x:Key="WindowBackground" Color="#FF1B1D20"/>
	<SolidColorBrush x:Key="WindowForeground" Color="#FF9AA0A6"/>
	<!-- Panel and dialog bodies, the filter bar, the "Manual" tag and the small buttons of the device list. -->
	<SolidColorBrush x:Key="SurfaceBackground" Color="#FF232528"/>
	<SolidColorBrush x:Key="SurfaceForeground" Color="#FFE4E6E8"/>
	<SolidColorBrush x:Key="DialogForeground" Color="#FFE4E6E8"/>
	<SolidColorBrush x:Key="PlaceholderForeground" Color="#FFB4BAC0"/>
	<SolidColorBrush x:Key="InputBorder" Color="#FF6A6E74"/>
	<!-- The links of the device and channel pages. -->
	<SolidColorBrush x:Key="LinkForeground" Color="#FFE4E6E8"/>
	<SolidColorBrush x:Key="LinkHoverForeground" Color="#FF8EC5FF"/>
	<SolidColorBrush x:Key="LinkSelectedForeground" Color="#FFFF8A80"/>
	<SolidColorBrush x:Key="LinkDisabledForeground" Color="#FF6B7076"/>
	<SolidColorBrush x:Key="FilterBackground" Color="#FF2F3236"/>
	<SolidColorBrush x:Key="TagBackground" Color="#FF4A2B2B"/>
	<SolidColorBrush x:Key="TagForeground" Color="#FFFFA39B"/>
	<SolidColorBrush x:Key="SmallButtonBackground" Color="#FF4A4E54"/>
	<!-- The names and values in the details of a profile, and the headers of the groups. -->
	<SolidColorBrush x:Key="DetailNameForeground" Color="#FFE4E6E8"/>
	<SolidColorBrush x:Key="SelectedItemForeground" Color="White"/>
	<!-- The rows of the devices in the batch upgrade and restore windows. -->
	<SolidColorBrush x:Key="DeviceRowBackground" Color="#FF2F3236"/>
	<SolidColorBrush x:Key="DetailValueForeground" Color="#FFA8AEB4"/>
	<SolidColorBrush x:Key="ExpanderHeaderBackground" Color="#FF2F3236"/>
	<SolidColorBrush x:Key="ExpanderHeaderHoverBackground" Color="#FF3A3D41"/>
	<SolidColorBrush x:Key="ExpanderHeaderHoverForeground" Color="#FFE4E6E8"/>

	<SolidColorBrush x:Key="ButtonBorder" Color="#FF5A5E63"/>
	<SolidColorBrush x:Key="ButtonBackground" Color="#FF3A3D41"/>
	<SolidColorBrush x:Key="ButtonBackgroundDark" Color="#FF2F3236"/>
	<SolidColorBrush x:Key="ButtonForeground" Color="#FFE4E6E8"/>
	<SolidColorBrush x:Key="ButtonBackgroundHighlight" Color="#FF4E6A8A"/>
	<SolidColorBrush x:Key="ButtonForegroundHighlight" Color="White"/>
	<SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#FF2C4A6B"/>
	<SolidColorBrush x:Key="ButtonForegroundPressed" Color="White"/>

	<SolidColorBrush x:Key="Background" Color="#FF2B2D30"/>
	<SolidColorBrush x:Key="Foreground" Color="#FFE4E6E8"/>
	<SolidColorBrush x:Key="BackgroundHighlight" Color="#FF16181A"/>
	<SolidColorBrush x:Key="BackgroundHeader" Color="#FF16181A"/>
	<SolidColorBrush x:Key="BackgroundHeaderSelected" Color="#FF30343A"/>
	<SolidColorBrush x:Key="BackgroundHeaderChecked" Color="#FF4E6A8A"/>
	<SolidColorBrush x:Key="ForegroundHighlight" Color="White"/>
	<SolidColorBrush x:Key="BackgroundPressed" Color="#FF2C4A6B"/>
	<SolidColorBrush x:Key="ForegroundPressed" Color="White"/>
	<SolidColorBrush x:Key="BackgroundDisabled" Color="#FF2B2D30"/>
	<SolidColorBrush x:Key="ForegroundDisabled" Color="#FF6B7076"/>
	<SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#FF2B2D30"/>
	<SolidColorBrush x:Key="BorderBrush" Color="#FF5A5E63"/>
	<SolidColorBrush x:Key="BackgroundReadOnly" Color="#FF34373B"/>
	<SolidColorBrush x:Key="ForegroundReadOnly" Color="#FF9AA0A6"/>
	<SolidColorBrush x:Key="TextBoxBackground" Color="#FF1F2124"/>
	<SolidColorBrush x:Key="ColumnBackground" Color="#FF16181A"/>
	<SolidColorBrush x:Key="PropertyBrush" Color="#FF2B2D30"/>

	<!-- The default WPF controls (TextBox, ListBox, ListView, tool tips) use the system colors. -->
	<SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#FF1F2124"/>
	<SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#FFE4E6E8"/>
	<SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#FF2B2D30"/>
	<SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#FFE4E6E8"/>
	<SolidColorBrush x:Key="{x:Static SystemColors.ControlLightBrushKey}" Color="#FF3A3D41"/>
	<SolidColorBrush x:Key="{x:Static SystemColors.ControlLightLightBrushKey}" Color="#FF45484D"/>
	<SolidColorBrush x:Key="{x:Static SystemColors.ControlDarkBrushKey}" Color="#FF5A5E63"/>
	<SolidColorBrush x:Key="{x:Static SystemColors.ControlDarkDarkBrushKey}" Color="#FF16181A"/>
	<SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#FF8A9096"/>
	<SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#FF3F6A99"/>
	<SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="White"/>
	<SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#FF3A3D41"/>
	<SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#FFE4E6E8"/>
	<SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="#FF2B2D30"/>
	<SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="#FFE4E6E8"/>
	<SolidColorBrush x:Key="{x:Static SystemColors.InfoBrushKey}" Color="#FF2B2D30"/>
	<SolidColorBrush x:Key="{x:Static SystemColors.InfoTextBrushKey}" Color="#FFE4E6E8"/>
	<SolidColorBrush x:Key="{x:Static SystemColors.WindowFrameBrushKey}" Color="#FF5A5E63"/>

	<!-- The default GroupBox of WPF has a white frame. In the dark theme use a thin gray frame. -->
	<Style TargetType="{x:Type GroupBox}">
		<Setter Property="BorderBrush" Value="#FF4A4E54"/>
		<Setter Property="Foreground" Value="#FFE4E6E8"/>
		<Setter Property="Padding" Value="6,4"/>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type GroupBox}">
					<Grid SnapsToDevicePixels="True">
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="*"/>
						</Grid.RowDefinitions>
						<ContentPresenter Grid.Row="0" Margin="2,4,2,3" ContentSource="Header" RecognizesAccessKey="True"
						                  TextElement.FontWeight="SemiBold"/>
						<Border Grid.Row="1" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="3"
						        Background="#FF26282B" Padding="{TemplateBinding Padding}">
							<ContentPresenter/>
						</Border>
					</Grid>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<!-- The built-in Windows theme of WPF gives ListView a navy text color (#FF042271) and light column headers.
	     These styles change only the colors. The rest of the built-in style stays. -->
	<Style TargetType="{x:Type ListView}">
		<Setter Property="Foreground" Value="#FFE4E6E8"/>
		<Setter Property="Background" Value="#FF1F2124"/>
		<Setter Property="BorderBrush" Value="#FF4A4E54"/>
	</Style>
	<!-- The built-in template has a light blue color when the mouse is on a header. This template uses dark colors. -->
	<Style TargetType="{x:Type GridViewColumnHeader}">
		<Setter Property="Foreground" Value="#FFE4E6E8"/>
		<Setter Property="Background" Value="#FF2F3236"/>
		<Setter Property="BorderBrush" Value="#FF4A4E54"/>
		<Setter Property="Padding" Value="4,2"/>
		<Setter Property="HorizontalContentAlignment" Value="Center"/>
		<Setter Property="VerticalContentAlignment" Value="Center"/>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type GridViewColumnHeader}">
					<Grid SnapsToDevicePixels="True">
						<Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,0,1,1">
							<ContentPresenter Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"
							                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
							                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
						</Border>
						<Thumb x:Name="PART_HeaderGripper" HorizontalAlignment="Right" Width="8" Margin="0,0,-4,0">
							<Thumb.Template>
								<ControlTemplate TargetType="{x:Type Thumb}">
									<Border Background="Transparent"/>
								</ControlTemplate>
							</Thumb.Template>
						</Thumb>
					</Grid>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="bd" Property="Background" Value="#FF3A3D41"/>
						</Trigger>
						<Trigger Property="IsPressed" Value="True">
							<Setter TargetName="bd" Property="Background" Value="#FF45494E"/>
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<!-- The selection colors of the built-in template are light. This template uses dark colors. -->
	<Style TargetType="{x:Type ListViewItem}">
		<Setter Property="Foreground" Value="#FFE4E6E8"/>
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="Padding" Value="4,1"/>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type ListViewItem}">
					<Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
						<Grid>
							<GridViewRowPresenter x:Name="rows" Columns="{TemplateBinding GridView.ColumnCollection}"
							                      Content="{TemplateBinding Content}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
							<!-- A ListView without a GridView shows the content directly. -->
							<ContentPresenter x:Name="content" Visibility="Collapsed" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
						</Grid>
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="GridView.ColumnCollection" Value="{x:Null}">
							<Setter TargetName="rows" Property="Visibility" Value="Collapsed"/>
							<Setter TargetName="content" Property="Visibility" Value="Visible"/>
						</Trigger>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="Bd" Property="Background" Value="#FF33373C"/>
						</Trigger>
						<MultiTrigger>
							<MultiTrigger.Conditions>
								<Condition Property="IsSelected" Value="True"/>
								<Condition Property="Selector.IsSelectionActive" Value="False"/>
							</MultiTrigger.Conditions>
							<Setter TargetName="Bd" Property="Background" Value="#FF3A3D41"/>
						</MultiTrigger>
						<MultiTrigger>
							<MultiTrigger.Conditions>
								<Condition Property="IsSelected" Value="True"/>
								<Condition Property="Selector.IsSelectionActive" Value="True"/>
							</MultiTrigger.Conditions>
							<Setter TargetName="Bd" Property="Background" Value="#FF3F6A99"/>
						</MultiTrigger>
						<Trigger Property="IsEnabled" Value="False">
							<Setter Property="Foreground" Value="#FF6B7076"/>
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<!-- The date pickers: the built-in text box has dark text. The calendar that opens stays light. -->
	<Style TargetType="{x:Type DatePicker}">
		<Setter Property="Foreground" Value="#FFE4E6E8"/>
		<Setter Property="Background" Value="#FF1F2124"/>
		<Setter Property="BorderBrush" Value="#FF6A6E74"/>
	</Style>
	<Style TargetType="{x:Type primitives:DatePickerTextBox}">
		<Setter Property="Foreground" Value="#FFE4E6E8"/>
		<Setter Property="Background" Value="#FF1F2124"/>
		<Setter Property="CaretBrush" Value="#FFE4E6E8"/>
		<!-- The built-in template draws the date dark. This template uses the Foreground. -->
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type primitives:DatePickerTextBox}">
					<Border Background="{TemplateBinding Background}" Padding="2,0">
						<ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}"
						              HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
					</Border>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
	<!-- The built-in DataGrid header is white. The credential and certificate windows use a DataGrid. -->
	<Style TargetType="{x:Type DataGrid}">
		<Setter Property="Background" Value="#FF1F2124"/>
		<Setter Property="Foreground" Value="#FFE4E6E8"/>
		<Setter Property="BorderBrush" Value="#FF4A4E54"/>
		<Setter Property="RowBackground" Value="Transparent"/>
		<Setter Property="HorizontalGridLinesBrush" Value="#FF3A3D41"/>
		<Setter Property="VerticalGridLinesBrush" Value="#FF3A3D41"/>
	</Style>
	<Style TargetType="{x:Type primitives:DataGridColumnHeader}">
		<Setter Property="Foreground" Value="#FFE4E6E8"/>
		<Setter Property="Background" Value="#FF2F3236"/>
		<Setter Property="BorderBrush" Value="#FF4A4E54"/>
		<Setter Property="Padding" Value="6,3"/>
		<Setter Property="VerticalContentAlignment" Value="Center"/>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type primitives:DataGridColumnHeader}">
					<Grid SnapsToDevicePixels="True">
						<Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,0,1,1">
							<ContentPresenter Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"
							                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
							                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
						</Border>
						<!-- The two grippers let the user change the column width. -->
						<Thumb x:Name="PART_LeftHeaderGripper" HorizontalAlignment="Left" Width="6" Cursor="SizeWE">
							<Thumb.Template>
								<ControlTemplate TargetType="{x:Type Thumb}">
									<Border Background="Transparent"/>
								</ControlTemplate>
							</Thumb.Template>
						</Thumb>
						<Thumb x:Name="PART_RightHeaderGripper" HorizontalAlignment="Right" Width="6" Cursor="SizeWE">
							<Thumb.Template>
								<ControlTemplate TargetType="{x:Type Thumb}">
									<Border Background="Transparent"/>
								</ControlTemplate>
							</Thumb.Template>
						</Thumb>
					</Grid>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="bd" Property="Background" Value="#FF3A3D41"/>
						</Trigger>
						<Trigger Property="IsPressed" Value="True">
							<Setter TargetName="bd" Property="Background" Value="#FF45494E"/>
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
</ResourceDictionary>
