<l:DialogWindow
    x:Class="odm.ui.views.SubnetScan"
    x:Name="root"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="clr-namespace:odm.ui.controls"
    ResizeMode="NoResize"
    WindowStyle="None"
	Header="{Binding Titles.subnetScan, ElementName=root}"
    Style="{DynamicResource dialog}"
    AllowsTransparency="True"
    Background="Transparent"
	TextOptions.TextFormattingMode="Display"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    SizeToContent="WidthAndHeight"
    SnapsToDevicePixels="true">

    <Grid Margin="6">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Label Grid.Column="0" Grid.Row="0" VerticalAlignment="Center" Content="{Binding Strings.scanAddresses, ElementName=root}"/>
        <TextBox Grid.Column="1" Grid.Row="0" x:Name="rangesText" Width="360" Margin="2" VerticalContentAlignment="Center" TextChanged="OnTextChanged"/>
        <TextBlock Grid.Column="1" Grid.Row="1" Margin="4,0,2,4" TextWrapping="Wrap" MaxWidth="360" HorizontalAlignment="Left"
                   Foreground="{DynamicResource PlaceholderForeground}" Text="{Binding Strings.scanHint, ElementName=root}"/>
        <!-- The mask gives the size of the subnet. Many users do not know the /24 form. -->
        <Label Grid.Column="0" Grid.Row="2" VerticalAlignment="Center" Content="{Binding Strings.scanMask, ElementName=root}"/>
        <ComboBox Grid.Column="1" Grid.Row="2" x:Name="maskCombo" Width="360" Margin="2" HorizontalAlignment="Left"
                  DisplayMemberPath="Text" SelectionChanged="OnMaskChanged"/>
        <TextBlock Grid.Column="1" Grid.Row="3" x:Name="errorText" Margin="4,2,2,4" TextWrapping="Wrap" MaxWidth="360" HorizontalAlignment="Left"
                   Foreground="Red" Visibility="Collapsed"/>
        <CheckBox Grid.Column="1" Grid.Row="4" x:Name="onRefreshCheck" Margin="2,4,2,6" Content="{Binding Strings.scanOnRefresh, ElementName=root}"/>
        <StackPanel Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="5" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button x:Name="btnScan" Content="{Binding Strings.scan, ElementName=root}" Click="OnScan" Margin="2" IsDefault="True"/>
            <Button Content="{Binding Buttons.cancel, ElementName=root}" Click="OnCancel" Margin="0,2,2,2" IsCancel="True"/>
        </StackPanel>
    </Grid>
</l:DialogWindow>
